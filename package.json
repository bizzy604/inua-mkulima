{
  "name": "inua-mkulima",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "setup:local": "node backend/scripts/setup-local.mjs",
    "dev": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "start": "npm run start --workspace backend",
    "typecheck": "npm run typecheck --workspace frontend && npm run typecheck --workspace backend",
    "test": "npm run test --workspace backend",
    "test:eval": "npm run test:eval --workspace backend",
    "test:infra": "npm run test:infra --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "db:reset": "npm run db:reset --workspace backend",
    "db:dump": "npm run db:dump --workspace backend"
  }
}
